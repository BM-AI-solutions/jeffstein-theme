{
  "$schema": "vscode://schemas/color-theme",
  "name": "Jeffstein Theme",
  "type": "dark",
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#FFFFFF",
    "editor.lineHighlightBackground": "#1e1e1e",
    "editor.selectionBackground": "#0078E690",
    "editorCursor.foreground": "#FFC400",
    "activityBar.background": "#111111",
    "activityBar.foreground": "#FFFFFF",
    "activityBarBadge.background": "#00AAE0",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#111111",
    "sideBar.foreground": "#CCCCCC",
    "sideBarSectionHeader.background": "#1a1a1a",
    "sideBarTitle.foreground": "#FFFFFF",
    "list.activeSelectionBackground": "#0078E6",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#333333",
    "list.hoverBackground": "#2a2a2a",
    "list.focusBackground": "#0078E6",
    "list.highlightForeground": "#00AAE0",
    "statusBar.background": "#0078E6",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.noFolderBackground": "#111111",
    "titleBar.activeBackground": "#111111",
    "titleBar.activeForeground": "#FFFFFF",
    "titleBar.inactiveBackground": "#111111",
    "titleBar.inactiveForeground": "#999999",
    "editorGroupHeader.tabsBackground": "#111111",
    "tab.inactiveBackground": "#222222",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#FFFFFF",
    "tab.inactiveForeground": "#999999",
    "tab.border": "#333333",
    "tab.activeBorderTop": "#00AAE0",
    "button.background": "#00AAE0",
    "button.foreground": "#000000",
    "input.background": "#2a2a2a",
    "dropdown.background": "#2a2a2a",
    "panel.background": "#111111",
    "panel.border": "#333333",
    "peekView.border": "#0078E6",
    "peekViewEditor.background": "#1a1a1a",
    "peekViewResult.background": "#111111",
    "peekViewTitle.background": "#222222",
    "editorWidget.background": "#1a1a1a",
    "editorGutter.background": "#000000",
    "terminal.background": "#000000",
    "terminal.foreground": "#FFFFFF",
    "terminalCursor.background": "#FFC400",
    "terminalCursor.foreground": "#000000",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#7F2B27",
    "terminal.ansiGreen": "#A40000",
    "terminal.ansiYellow": "#F8FF00",
    "terminal.ansiBlue": "#0078E6",
    "terminal.ansiMagenta": "#fc00b9",
    "terminal.ansiCyan": "#03c6fc",
    "terminal.ansiWhite": "#FFFFFF",
    "terminal.ansiBrightBlack": "#FFFFFF",
    "terminal.ansiBrightRed": "#FF0000",
    "terminal.ansiBrightGreen": "#EBFF00",
    "terminal.ansiBrightYellow": "#F8FF00",
    "terminal.ansiBrightBlue": "#00AAE0",
    "terminal.ansiBrightMagenta": "#fc00b9",
    "terminal.ansiBrightCyan": "#25B8FF",
    "terminal.ansiBrightWhite": "#FFFFFF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#888888"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#03c6fc"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#F8FF00"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#25B8FF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#fc00b9"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#EBFF00",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#00AAE0"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#FF0000"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#EBFF00"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#FF0000",
        "fontStyle": "underline"
      }
    }
  ]
}